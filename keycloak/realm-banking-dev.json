{
  "id": "banking-intelligence",
  "realm": "banking-intelligence",
  "displayName": "Banking Intelligence System",
  "displayNameHtml": "<strong>Banking Intelligence</strong>",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "passwordPolicy": "length(8) and upperCase(1) and lowerCase(1) and digits(1)",
  "accessTokenLifespan": 600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespanForImplicitFlow": 900,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "roles": {
    "realm": [
      {
        "name": "banking_analyst",
        "description": "Banking analyst - access to business data, KPIs, risk overview"
      },
      {
        "name": "executive_manager",
        "description": "Executive manager - access to business data, reports, summaries"
      },
      {
        "name": "risk_officer",
        "description": "Risk officer - maps to analyst in Increment 1A, dedicated role later"
      },
      {
        "name": "compliance_officer",
        "description": "Compliance officer - access to compliance, audit logs, PII"
      },
      {
        "name": "internal_auditor",
        "description": "Internal auditor - maps to compliance in Increment 1A, dedicated role later"
      },
      {
        "name": "administrator",
        "description": "Administrator - full system access including user management"
      },
      {
        "name": "custom_unknown_role",
        "description": "Test-only: unmapped role for validation testing"
      }
    ]
  },
  "clients": [
    {
      "clientId": "banking-portal-web",
      "name": "Banking Portal Web Client",
      "description": "React frontend - Authorization Code Flow with PKCE",
      "enabled": true,
      "clientAuthenticatorType": "client-dummy",
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:3000/callback"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "basic"
      ],
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_roles",
            "jsonType.label": "String",
            "usermodel.realmRoleMapping.roleAttribute": "attribute"
          }
        },
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "banking-portal-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "banking-portal-api",
      "name": "Banking Portal API",
      "description": "API audience for access tokens",
      "enabled": true,
      "clientAuthenticatorType": "client-dummy",
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "banking-portal-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
