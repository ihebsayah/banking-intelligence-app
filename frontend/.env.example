# Frontend environment variables (Vite)
# Copy this file to Frontend/.env and fill in real values

# Authentication provider: 'legacy' (HS256 JWT) or 'keycloak' (RS256 OIDC)
VITE_AUTH_PROVIDER=legacy

# Keycloak configuration (required when VITE_AUTH_PROVIDER=keycloak)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=banking-intelligence
VITE_KEYCLOAK_CLIENT_ID=banking-portal-web

# API base URL (proxied by Vite dev server, or direct gateway URL)
VITE_API_BASE_URL=/api
