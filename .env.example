# ============================================================
# BANKING INTELLIGENCE SYSTEM — Environment Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
#
#   cp .env.example .env
# ============================================================

# ============================================================
# LLM — Ollama / Mistral (local)
# ============================================================
MISTRAL_API_URL=http://ollama:11434
MISTRAL_MODEL=mistral
ORCHESTRATOR_LLM=mistral
LLM_TIMEOUT=120
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.7

# ============================================================
# Database Credentials
# Change ALL passwords before any non-local deployment.
# ============================================================
POSTGRES_MAIN_USER=banking_user
POSTGRES_MAIN_PASSWORD=CHANGE_ME_MAIN
POSTGRES_MAIN_DB=banking_dev

POSTGRES_AUDIT_USER=audit_user
POSTGRES_AUDIT_PASSWORD=CHANGE_ME_AUDIT
POSTGRES_AUDIT_DB=audit_logs

POSTGRES_EMBEDDINGS_USER=embedding_user
POSTGRES_EMBEDDINGS_PASSWORD=CHANGE_ME_EMBEDDINGS
POSTGRES_EMBEDDINGS_DB=embeddings

# ============================================================
# Derived DATABASE URLs (built from above — do not edit manually)
# ============================================================
DATABASE_URL=postgresql://${POSTGRES_MAIN_USER}:${POSTGRES_MAIN_PASSWORD}@postgres-main:5432/${POSTGRES_MAIN_DB}
AUDIT_DATABASE_URL=postgresql://${POSTGRES_AUDIT_USER}:${POSTGRES_AUDIT_PASSWORD}@postgres-audit:5432/${POSTGRES_AUDIT_DB}
POSTGRES_EMBEDDINGS_URL=postgresql://${POSTGRES_EMBEDDINGS_USER}:${POSTGRES_EMBEDDINGS_PASSWORD}@postgres-embeddings:5432/${POSTGRES_EMBEDDINGS_DB}

# ============================================================
# Redis
# ============================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ============================================================
# JWT — MUST change both secrets before any deployment
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================
JWT_SECRET_KEY=CHANGE_ME_USE_256BIT_RANDOM_VALUE
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ============================================================
# Query Signing — MUST change before any deployment
# ============================================================
QUERY_SIGNING_KEY=CHANGE_ME_USE_RANDOM_VALUE

# ============================================================
# Internal Service URLs (Docker network names)
# ============================================================
API_GATEWAY_URL=http://api-gateway:8000
ORCHESTRATOR_URL=http://orchestrator-agent:8001
INTENT_AGENT_URL=http://intent-agent:8002
SCHEMA_AGENT_URL=http://schema-agent:8003
ENTITY_RESOLUTION_AGENT_URL=http://entity-resolution-agent:8004
SQL_AGENT_URL=http://sql-agent:8005
VALIDATION_AGENT_URL=http://validation-agent:8006
EXECUTION_AGENT_URL=http://execution-agent:8007
AUDIT_AGENT_URL=http://audit-agent:8008
EMBEDDING_SERVICE_URL=http://embedding-service:8009
SECRETS_MANAGER_URL=http://secrets-manager:8010
COMPLIANCE_AGENT_URL=http://compliance-agent:8011
AUDIT_ENHANCEMENT_URL=http://audit-enhancement:8012
INSIGHTS_AGENT_URL=http://insights-agent:8013
DEBUG_SERVICE_URL=http://debug-service:8099

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
# Use DEBUG for local development: LOG_LEVEL=DEBUG

# ============================================================
# Feature Flags
# ============================================================
ENABLE_INSIGHTS_AGENT=false
ENABLE_ADVANCED_ML=false
ENABLE_CACHING=true
