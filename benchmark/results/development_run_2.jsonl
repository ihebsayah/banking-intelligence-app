{"question_id": "D024", "question": "What is the loan to deposit ratio?", "language": "en", "category": "governed", "difficulty": "hard", "supported_expected": true, "plan_correct": true, "plan_hash": "8f5e3b7fa0565bf5", "sql_compiled": true, "sql_hash": "2c20714b15e5903b", "sql": "SELECT\n    ROUND(100.0 * _num.num::numeric / NULLIF(_den.den::numeric, 0), 2) AS loan_to_deposit\nFROM\n    (SELECT COALESCE(SUM(lc.principal_amount), 0) AS num FROM loan_contracts lc WHERE lc.currency = 'TND') AS _num,\n    (SELECT COALESCE(SUM(a.balance), 0) AS den FROM accounts a WHERE a.currency = 'TND') AS _den\nLIMIT 100", "sql_executed": true, "result_rows": 1, "result_verified": true, "failure_stage": null, "failure_reason": null, "latency_ms": {"planning": 0.3, "compilation": 0.19, "database": 15.65, "verification": 0.04, "total": 16.17}, "supported_actual": true, "intent_correct": true, "semantic_retrieval_correct": true, "answer_correct": true, "unsupported_correctly": false, "unsafe_execution": false}
